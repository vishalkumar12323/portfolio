generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Visit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@map("visits")
}
