generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Visit {
  id        Int      @id @default(autoincrement())
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@map("visits")
}
