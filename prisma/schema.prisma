// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Projects {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  projectName     String   @map("project_name")
  projectImages   String[] @map("project_images")
  description     String
  liveProjectLink String?  @map("live_project_link")
  githubLink      String   @map("github_link")
  tech            String[] @map("technologies")

  statsId String? @db.ObjectId
  stats   Stats?  @relation(fields: [statsId], references: [id])

  @@map("projects")
}

model Stats {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  commitId      String   @map("commit_id")
  commitMessage String   @map("commit_message")
  commitUrl     String   @map("commit_url")
  timestamp     DateTime @map("timestamp")

  createdAt DateTime   @default(now()) @map("created_at")
  projects  Projects[]

  @@map("stats")
}
